# Same-origin reverse proxy to the api service. The image build derives an
# optional public subpath from ERP_PUBLIC_URL, then rewrites it exactly once
# before these root-owned API/static locations handle the request.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location /health {
    proxy_pass http://api:3000/health;
    proxy_set_header Host $host;
  }

  location /api/ {
    proxy_pass http://api:3000/api/;
    proxy_set_header Host $host;
  }

  __ERP_PUBLIC_PREFIX_LOCATIONS__

  # The shell and service worker must be revalidated so an installed PWA can
  # discover source releases and present its explicit Update action.
  location = /index.html {
    add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    try_files $uri =404;
  }

  location = /sw.js {
    add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    add_header Service-Worker-Allowed "/" always;
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
