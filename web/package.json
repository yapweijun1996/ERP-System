{
  "name": "@erp-system/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && VITE_PLATFORM_DEMO_AUTOFILL=${VITE_PLATFORM_DEMO_AUTOFILL:-false} VITE_DATA_MODE=api vite build",
    "build:demo": "tsc --noEmit && VITE_PLATFORM_DEMO_AUTOFILL=${VITE_PLATFORM_DEMO_AUTOFILL:-false} VITE_DATA_MODE=demo vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "drizzle-orm": "^0.45.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
