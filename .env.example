# Copy to .env and fill in. NEVER commit .env.

# Keep this stable on a client server. It determines the Docker volume namespace;
# changing it later makes the old volume look like a different deployment.
COMPOSE_PROJECT_NAME=erp-system

# Data mode: "demo" (PGlite/IndexedDB) or "api" (Node + PostgreSQL)
VITE_DATA_MODE=api

# Production database (api mode only)
DB_USER=erp
DB_PASSWORD=change-me

# DATABASE_URL: only set this if pointing api/worker at a database you already
# provisioned yourself (managed RDS/Cloud SQL/Supabase/etc). Leave unset to use
# the bundled `db` container built from DB_USER/DB_PASSWORD above — Compose
# derives it automatically (postgresql://$DB_USER:$DB_PASSWORD@db:5432/erp).
# `scripts/setup.sh --interactive` fills this in for you when you choose an
# external database.
# DATABASE_URL=postgresql://user:pass@external-host:5432/erp

# Auth transport. Keep false only for local HTTP. Production behind HTTPS must
# set COOKIE_SECURE=true; set TRUST_PROXY=true behind one trusted reverse proxy.
COOKIE_SECURE=false
TRUST_PROXY=false

# Production account lifecycle. Generate the encryption key with, for example:
#   openssl rand -base64 32
# The encryption key must decode to exactly 32 bytes. Never use VITE_ prefixes:
# these values must remain server-side.
ERP_TOKEN_ENCRYPTION_KEY=
ERP_PUBLIC_URL=http://localhost:8080

# SMTP is consumed only by the optional `email` worker profile:
#   docker compose --profile email up -d worker
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Aria ERP <no-reply@example.com>"
OUTBOX_POLL_MS=5000

# Optional one-way calendar connector. The always-on calendar-worker posts
# privacy-redacted leave and opt-in appointment facts to this server-side
# endpoint. ERP remains authoritative; the token is never exposed to the browser.
CALENDAR_OUTBOUND_URL=
CALENDAR_OUTBOUND_TOKEN=
CALENDAR_OUTBOUND_TIMEOUT_MS=15000
CALENDAR_WORKER_ID=erp-calendar-worker
CALENDAR_POLL_MS=15000

# Optional document content backend. Leave blank for the default PostgreSQL
# bytea provider. Setting this enables the explicitly single-node filesystem
# provider; metadata, tenant ownership, hashes, versions, retention and legal
# hold remain authoritative in PostgreSQL. The bundled Compose stack mounts a
# local named volume at this path.
# DOCUMENT_STORAGE_FS_ROOT=/var/lib/erp-documents

# CI: Personal Access Token to push the demo dist/ to the public Pages repo.
# Set this as a GitHub Actions secret, NOT here. The default GITHUB_TOKEN
# cannot push to a different repository.
# DEPLOY_PAT=

# ---------------------------------------------------------------------------
# LLM provider — this ERP is BYOK (Bring Your Own Key). See docs/AI_PROVIDERS.md.
# There are intentionally NO provider API keys here: the system never holds one.
# Each user enters THEIR OWN key at runtime (browser-side). Only non-secret
# DEFAULTS may be set below to pre-fill the UI.
# 🔴 Never add a key here, and never prefix anything with VITE_ (Vite inlines
#    VITE_* into the public dist/).
# ---------------------------------------------------------------------------
LLM_DEFAULT_PROVIDER=openai                       # openai | deepseek | lmstudio | gemini (UI default only)
LLM_DEFAULT_BASE_URL=https://api.openai.com/v1    # deepseek: https://api.deepseek.com ; lmstudio: http://localhost:1234/v1
LLM_DEFAULT_MODEL=gpt-4o-mini

# Host port overrides (optional — docker-compose.yml defaults to WEB_PORT=8080,
# API_PORT=3000, DB_PORT=5432). Uncomment and change if those collide with
# something else already running on the host (a native PostgreSQL install on
# 5432, or another dev tool on 3000/8080 are common — this bit a real setup
# verification run, TASK-021, on a machine with several other services up).
# WEB_PORT=18080
# API_PORT=13000
# DB_PORT=15432
