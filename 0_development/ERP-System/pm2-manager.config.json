{
  "resurrectOnStartAllWhenEmpty": true,
  "profiles": {
    "prod": [
      {
        "name": "ERP-backend",
        "url": "http://localhost:6601",
        "startArgs": [
          "start",
          "src/index.js",
          "--name",
          "ERP-backend",
          "--cwd",
          "server"
        ]
      },
      {
        "name": "ERP-frontend",
        "url": "http://localhost:6600",
        "preStart": ["npm run build"],
        "startArgs": ["serve", "dist", "6600", "--name", "ERP-frontend", "--spa"]
      }
    ],
    "dev": [
      {
        "name": "ERP-backend",
        "url": "http://localhost:6601",
        "startArgs": [
          "start",
          "src/index.js",
          "--name",
          "ERP-backend",
          "--cwd",
          "server"
        ]
      },
      {
        "name": "ERP-frontend",
        "url": "http://localhost:6600",
        "startArgs": [
          "start",
          "npm",
          "--name",
          "ERP-frontend",
          "--",
          "run",
          "dev",
          "--",
          "--host",
          "0.0.0.0",
          "--port",
          "6600"
        ]
      }
    ]
  }
}
