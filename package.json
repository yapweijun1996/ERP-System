{
  "name": "erp-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dual-mode multi-tenant ERP — PGlite demo + PostgreSQL production",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "build:demo": "npm --prefix web run build:demo",
    "preview": "npm --prefix web run preview",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "npm --prefix web run typecheck",
    "lint": "eslint .",
    "generate": "drizzle-kit generate",
    "generate:demo-schema": "node scripts/generate-demo-schema.mjs",
    "check:demo-schema": "node scripts/generate-demo-schema.mjs --check",
    "generate:demo-pack": "node scripts/generate-demo-pack.mjs",
    "check:demo-pack": "node scripts/generate-demo-pack.mjs --check",
    "generate:i18n-bootstrap": "node scripts/generate-i18n-bootstrap.mjs",
    "check:i18n-bootstrap": "node scripts/generate-i18n-bootstrap.mjs --check",
    "generate:i18n-business": "node scripts/generate-i18n-business-allowlist.mjs",
    "check:i18n-business": "node scripts/generate-i18n-business-allowlist.mjs --check",
    "migrate": "drizzle-kit migrate",
    "demo": "tsx src/demo.ts",
    "server": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "seed": "tsx src/seed.ts",
    "check:drift": "node scripts/check-drift.mjs",
    "check:permissions": "tsx scripts/check-permissions.ts",
    "smoke": "node scripts/smoke.mjs",
    "audit:screens": "node scripts/audit-screens.mjs",
    "audit:i18n": "node scripts/audit-i18n.mjs --browser",
    "audit:pwa-update": "node scripts/audit-pwa-update.mjs",
    "audit:payroll-run": "PAYROLL_RUN_ONLY=1 node scripts/audit-screens.mjs",
    "audit:list-layouts": "LIST_LAYOUT_ONLY=1 node scripts/audit-screens.mjs",
    "audit:workspaces": "WORKSPACE_LAYOUT_ONLY=1 node scripts/audit-screens.mjs",
    "audit:calendar-workspaces": "CALENDAR_WORKSPACE_ONLY=1 node scripts/audit-screens.mjs",
    "audit:expense-workspaces": "node scripts/audit-expense-workspaces.mjs",
    "audit:master-detail-editors": "MASTER_DETAIL_EDITOR_ONLY=1 node scripts/audit-screens.mjs",
    "audit:case-details": "CASE_DETAIL_ONLY=1 node scripts/audit-screens.mjs",
    "audit:document-details": "DOCUMENT_DETAIL_ONLY=1 node scripts/audit-screens.mjs",
    "audit:ledger-details": "LEDGER_DETAIL_ONLY=1 node scripts/audit-screens.mjs",
    "audit:posting-details": "POSTING_DETAIL_ONLY=1 node scripts/audit-screens.mjs",
    "audit:financial-statements": "FINANCIAL_STATEMENT_ONLY=1 node scripts/audit-screens.mjs",
    "test": "vitest run",
    "test:postgres": "vitest run src/api/postgresSecurity.integration.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "playwright": "^1.61.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "esbuild": "0.28.0",
    "exceljs": {
      "archiver": "8.0.0",
      "unzipper": "0.12.5",
      "uuid": "11.1.1"
    }
  }
}
