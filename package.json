{
  "name": "erp-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dual-mode multi-tenant ERP — PGlite demo + PostgreSQL production",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "build:demo": "npm --prefix web run build:demo",
    "preview": "npm --prefix web run preview",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "npm --prefix web run typecheck",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "demo": "tsx src/demo.ts",
    "server": "tsx src/server.ts",
    "seed": "tsx src/seed.ts",
    "check:drift": "node scripts/check-drift.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.28.1",
    "playwright": "^1.61.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.1",
    "drizzle-orm": "^0.36.4",
    "express": "^5.2.1",
    "pg": "^8.21.0"
  }
}
